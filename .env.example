# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

DATABASE_URL=sqlite:///./app.db

# R2 (Cloudflare). Never commit real keys. Never paste the secret in chat.
# Default endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# US jurisdiction:  https://<ACCOUNT_ID>.us.r2.cloudflarestorage.com
# EU jurisdiction:  https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE=https://cdn.oneira.cc
