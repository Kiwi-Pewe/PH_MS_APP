# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

DATABASE_URL=sqlite:///./app.db

# R2 (Cloudflare). Never commit real keys. Never paste the secret in chat.
# Account ID is on the R2 overview page. Endpoint is
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# If the bucket was created in a jurisdiction (EU / US), the host changes —
# see Cloudflare R2 token docs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=https://cdn.oneira.cc
